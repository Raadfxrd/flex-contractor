# Absolute origin. Used for canonical URLs, og:url, sitemap.xml and robots.txt.
NUXT_PUBLIC_SITE_URL=https://www.flexcontractor.com

# Contact form delivery. ALL THREE are required for the form to actually send.
# Without them /api/contact answers 503 { code: 'not_configured' } and the form
# tells the visitor the message was not sent, rather than faking a success.
NUXT_RESEND_API_KEY=
NUXT_CONTACT_TO_EMAIL=
NUXT_CONTACT_FROM_EMAIL=
